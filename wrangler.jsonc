// Configuración para publicar en Cloudflare (Workers con archivos estáticos).
// Cloudflare corre `npm run build` y luego `npx wrangler deploy`, que sube la carpeta dist/.
{
  "name": "chirilanding", // debe coincidir con el nombre del proyecto en Cloudflare
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    // Cualquier ruta desconocida muestra la landing en vez de un error 404
    "not_found_handling": "single-page-application",
  },
}
